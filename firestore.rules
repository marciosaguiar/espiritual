rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// LevitaSync — regras de segurança do Firestore
//
// Agora o login é conferido pelo Firebase Authentication, então o banco sabe
// QUEM está fazendo cada pedido (request.auth.uid). É isso que permite regras
// de verdade, e não só limites de tamanho como na versão anterior.
//
// Em resumo:
//   · nada é legível sem estar logado E aprovado por um líder;
//   · quem acabou de se cadastrar nasce `pendente` e enxerga só o próprio
//     cadastro, até o líder aprovar ou recusar em Perfil → Membros;
//   · cada pessoa só edita o próprio perfil, e não a própria função;
//   · só o líder cria e altera músicas, arranjos e cultos;
//   · APAGAR qualquer coisa é só do líder;
//   · suas anotações e tons ficam numa subcoleção que só você acessa;
//   · mensagem enviada não se altera nem se apaga.
//
// Como publicar:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Quem é quem ─────────────────────────────────────────────────────────

    function logado() {
      return request.auth != null;
    }

    function eu() {
      return request.auth.uid;
    }

    function souEu(userId) {
      return logado() && eu() == userId;
    }

    // Lê a função no próprio cadastro. Atenção: cada uso desta função custa
    // uma leitura no Firestore (elas são cobradas), por isso ela aparece só
    // onde é realmente necessária.
    function ehLider() {
      return logado()
        && exists(/databases/$(database)/documents/users/$(eu()))
        && get(/databases/$(database)/documents/users/$(eu())).data.role == 'admin';
    }

    // Passou pela aprovação do líder.
    //
    // Esta é a trava de verdade da entrada. O endereço do app é público, então
    // qualquer pessoa com o link cria uma conta; sem esta função ela estaria
    // lendo o chat, a escala e o repertório do ministério no mesmo instante.
    //
    // A lista é fechada de propósito: só `levita` e `admin` entram. Função
    // desconhecida — campo faltando, documento meio gravado, nome escrito
    // errado no console — fica DE FORA. Um valor que não se reconhece tem de
    // significar menos acesso, nunca o acesso normal.
    function aprovado() {
      return logado()
        && exists(/databases/$(database)/documents/users/$(eu()))
        && get(/databases/$(database)/documents/users/$(eu())).data.role
             in ['levita', 'admin'];
    }

    // As quatro funções que existem. Serve para um erro de digitação não
    // criar um quinto estado que ninguém sabe o que faz.
    //
    // `recusado` saiu: recusar um pedido novo e tirar alguém já aprovado
    // viraram o MESMO estado, `removido`. Documento antigo com 'recusado' o
    // app lê como removido, e esta lista recusa gravá-lo de novo.
    function funcaoValida() {
      return request.resource.data.role in
        ['pendente', 'levita', 'admin', 'removido'];
    }

    // O carimbo de quem saiu: quando, e por quem. Nulo é válido — é assim
    // que "devolver acesso" limpa os dois.
    function carimboDeSaidaValido() {
      return (!('removedAt' in request.resource.data)
              || request.resource.data.removedAt == null
              || request.resource.data.removedAt is timestamp)
        && texto('removedBy', 128);
    }

    // Sair do ministério por conta própria.
    //
    // É a única mudança de função que alguém faz em si mesmo, e só tem uma
    // direção: de dentro para fora. O contrário — sair de `removido` — fica
    // de fora de propósito, senão qualquer pessoa removida se readmitiria.
    //
    // O limite do último líder NÃO cabe aqui: a regra teria de contar quantos
    // admins existem, e contar exige consulta, que regra do Firestore não
    // faz. Essa proteção é só do app (ver removerDoMinisterio e o botão
    // "Sair do ministério"). Vale para um erro, não contra má-fé — e todo
    // líder aqui é gente de confiança do próprio ministério.
    function saindoPorContaPropria() {
      return resource.data.role in ['levita', 'admin']
        && request.resource.data.role == 'removido'
        && request.resource.data.removedBy == eu();
    }

    // ── Validações ──────────────────────────────────────────────────────────

    // Campo de texto opcional, dentro de um limite de tamanho.
    //
    // O `== null` não é zelo: o app grava `photoUrl: null` em todo cadastro,
    // e sem esta linha `null is string` dava falso e a regra inteira recusava
    // criar conta, editar o próprio perfil e promover um membro. Confirmado
    // no emulador — era um app que não deixaria ninguém entrar.
    function texto(campo, maximo) {
      return !(campo in request.resource.data)
        || request.resource.data[campo] == null
        || (request.resource.data[campo] is string
            && request.resource.data[campo].size() <= maximo);
    }

    // "Tirada do repertório": o campo e o carimbo de quem tirou e quando.
    // Nulo é válido — é assim que devolver ao repertório os limpa.
    function arquivamentoValido() {
      return (!('archived' in request.resource.data)
              || request.resource.data.archived is bool)
        && (!('archivedAt' in request.resource.data)
            || request.resource.data.archivedAt == null
            || request.resource.data.archivedAt is timestamp)
        && texto('archivedBy', 128);
    }

    function tamanhoRazoavel() {
      return request.resource.data.keys().size() <= 30;
    }

    // Campos que mudaram nesta escrita.
    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Usuários ────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Quem já faz parte vê a lista (nomes e instrumentos aparecem na escala
      // e no chat). Quem está esperando aprovação vê apenas o PRÓPRIO
      // cadastro — e precisa vê-lo, senão o app não teria como saber que a
      // pessoa está pendente e mostraria o aplicativo todo vazio, sem
      // explicação, parecendo defeito.
      allow read: if souEu(userId) || aprovado();

      // Só dá para criar o SEU próprio cadastro, com o id da sua conta, e
      // sempre como pendente.
      //
      // Dois motivos numa linha só. Primeiro: o endereço do app é público, e
      // sem ela qualquer pessoa se registraria como administradora pela API.
      // Segundo: todo cadastro novo tem de parar aqui até um líder aprovar,
      // porque até então não há nada que impeça um estranho de entrar.
      //
      // O primeiro líder é promovido uma vez no console do Firebase
      // (pendente → admin); daí em diante os líderes aprovam e promovem os
      // outros pelo app.
      allow create: if souEu(userId)
        && tamanhoRazoavel()
        && request.resource.data.role == 'pendente'
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && texto('photoUrl', 500)
        && !('passwordHash' in request.resource.data);

      // Você edita o seu perfil, menos a sua função — senão qualquer um se
      // promoveria a líder, ou se aprovaria sozinho.
      //
      // Quem está pendente também edita o próprio nome: é a única coisa que
      // ele consegue fazer, e consertar o nome antes de o líder decidir é
      // razoável.
      allow update: if tamanhoRazoavel()
        && funcaoValida()
        && carimboDeSaidaValido()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && texto('photoUrl', 500)
        && !('passwordHash' in request.resource.data)
        // "Eu canto" / "Eu toco" no perfil.
        && (!('leitura' in request.resource.data)
            || request.resource.data.leitura in ['canto', 'toco'])
        && (!('bot' in request.resource.data)
            || request.resource.data.bot is bool)
        // "Esta conta tem e-mail de verdade para recuperar a senha."
        //
        // Só o sim/não vem para o banco: o endereço fica no Firebase
        // Authentication. Todo aprovado lê `users`, então gravar o e-mail
        // pessoal de cada um entregaria a lista de e-mails do ministério a
        // qualquer membro.
        && (!('recuperacaoPorEmail' in request.resource.data)
            || request.resource.data.recuperacaoPorEmail is bool)
        // Várias funções por pessoa: a lista é fechada, como a das funções do
        // ministério. Lista vazia é recusada — sem função, a escala não sabe
        // o que oferecer e o modo de leitura não tem de onde sair.
        && (!('instruments' in request.resource.data)
            || (request.resource.data.instruments is list
                && request.resource.data.instruments.size() >= 1
                && request.resource.data.instruments.size() <= 6
                && request.resource.data.instruments.hasOnly(
                    ['vocalist', 'guitar', 'bass', 'drums', 'keyboard',
                     'other'])))
        && (
          // Seu próprio perfil: nome, instrumento, "eu canto / eu toco".
          // Exige estar aprovado — quem está pendente ou removido não
          // escreve nada em lugar nenhum, nem no próprio cadastro.
          //
          // `bot` fica DE FORA: conta de robô não entra em escala, equipe,
          // contagem nem aviso. Quem se marcasse robô sairia das escalas e
          // ninguém entenderia por que deixou de ser chamado. Marcar é só do
          // líder, e com confirmação pelo nome.
          (souEu(userId) && aprovado()
              && !('role' in mudou()) && !('bot' in mudou()))
          // Sair do ministério por conta própria.
          || (souEu(userId) && saindoPorContaPropria()
              && !('bot' in mudou()))
          // O líder decide sobre os outros: aprovar, recusar, promover,
          // remover e devolver o acesso.
          || ehLider()
        );

      // Ninguém apaga contas pelo app.
      allow delete: if false;

      // ── Minhas preferências por música (tom, anotações) ───────────────────
      // Particular: nem o líder lê as anotações de outra pessoa.
      match /songPrefs/{songId} {
        allow read, write: if souEu(userId)
          && tamanhoRazoavel()
          && texto('notes', 2000);
      }
    }

    // ── Músicas ─────────────────────────────────────────────────────────────
    match /songs/{songId} {
      allow read: if aprovado();

      // Só o líder cadastra, e só ele tira do repertório e devolve. Como
      // tirar do repertório é um update comum, a mesma linha cobre as duas
      // coisas: ninguém além do líder arquiva ou desarquiva.
      allow create: if ehLider() && _musicaValida();

      // Corrigir o CADASTRO é também de quem cadastrou a música.
      //
      // Quem digitou o nome errado é quem mais precisa consertá-lo, e antes
      // só o líder podia — a música ficava errada para sempre, ou era
      // cadastrada de novo, perdendo o histórico dos cultos.
      //
      // A lista fechada é o que separa "corrigir o cadastro" de "mexer no
      // repertório": `archived` fica de fora, então quem cadastrou não tira
      // nada do repertório, e `lyrics` também, porque trocar a letra é o que
      // "Colar cifra" faz, e isso é do líder.
      allow update: if _musicaValida()
        && (
          ehLider()
          || (aprovado()
              && resource.data.addedBy == eu()
              && request.resource.data.addedBy == eu()
              && mudou().hasOnly(
                  ['name', 'artist', 'originalKey', 'links', 'observacoes']))
        );

      function _musicaValida() {
        return tamanhoRazoavel()
          && texto('name', 150)
          && texto('artist', 150)
          && texto('lyrics', 20000)
          && texto('originalKey', 10)
          && texto('observacoes', 2000)
          && arquivamentoValido()
          && _hinoValido();
      }

      // ── Hino de hinário impresso ──────────────────────────────────────────
      //
      // `hinario` + `numero` são o que faz "o hino 15" abrir em segundos, pelo
      // teclado numérico. A regra existe por dois motivos.
      //
      // Primeiro: os dois campos ANDAM JUNTOS. Hinário sem número não dá para
      // abrir; número sem hinário não dá para saber de onde é. Documento pela
      // metade é o jeito mais silencioso de o teclado parar de achar o hino,
      // sem nada na tela explicando.
      //
      // Segundo: a lista de hinários é FECHADA. Um id escrito errado no
      // console viraria um hino que nenhuma tela do app oferece — e, como em
      // `funcaoValida()`, nome desconhecido tem de significar MENOS, nunca o
      // comportamento normal.
      //
      // O teto do número aqui é LARGO de propósito (9999). O teto de verdade
      // é 640 na Harpa e 581 no Cantor, e ele mora no app
      // (`Hinario.ultimo`), onde se troca sem deploy de regra. Repetir o
      // número exato aqui criaria a mesma armadilha da trava de tamanho que
      // reprovou todo deploy por dias: um número que pode mudar, guardado no
      // lugar mais difícil de mudar. A regra impede lixo; quem diz "não
      // existe o hino 700" é a tela.
      function _hinoValido() {
        let d = request.resource.data;
        let temHinario = 'hinario' in d && d.hinario != null && d.hinario != '';
        let temNumero = 'numero' in d && d.numero != null;
        return temHinario == temNumero
          && (!temHinario
              || (d.hinario is string && d.hinario in ['harpa', 'cantor']))
          && (!temNumero
              || (d.numero is int && d.numero >= 1 && d.numero <= 9999));
      }

      // NINGUÉM apaga música pelo app, nem o líder.
      //
      // O repertório inteiro sumiu do banco uma vez, em 14/11/2026, com a
      // confirmação de excluir sem sequer dizer o nome da música. Apagar
      // passou a ser "tirar do repertório": um campo, como cancelar culto.
      // Assim o nome continua aparecendo nos cultos em que a música foi
      // tocada, e um engano tem conserto. Apagar de verdade, se um dia for
      // mesmo preciso, só pelo console do Firebase — onde não se chega por
      // engano no meio de um culto.
      allow delete: if false;

      // ── Arranjo da igreja ─────────────────────────────────────────────────
      // Como a NOSSA igreja toca a música: cifra, tom, estrutura, andamento.
      match /arrangements/{arrangementId} {
        allow read: if aprovado();

        allow create, update: if ehLider()
          && tamanhoRazoavel()
          && texto('chords', 20000)
          && texto('churchKey', 10)
          && texto('notes', 5000);

        // Pelo mesmo motivo da música: a cifra da igreja é trabalho de
        // muita gente e não some por um toque errado.
        allow delete: if false;
      }
    }

    // ── Biblioteca de hinários ──────────────────────────────────────────────
    //
    // O TEXTO dos hinos que o líder importa (Harpa Cristã, Cantor Cristão).
    //
    //   hinarios/{id}               o ÍNDICE: {titulos: {"15": "Sou Grato"}}
    //   hinarios/{id}/hinos/{n}     a letra de UM hino
    //
    // POR QUE NÃO É `songs`: o app escuta a coleção `songs` INTEIRA, e cada
    // aparelho a relê toda vez que fica mais de 30 minutos parado. Com os
    // ~1.200 hinos lá dentro, uma igreja de 15 pessoas passaria das 50 mil
    // leituras grátis do dia num domingo comum — e, acabada a cota, o app
    // inteiro para de ler, não só os hinos. Aqui, o índice custa UMA leitura
    // por hinário e a letra só é lida quando alguém abre aquele hino. O hino
    // só vira música de `songs` quando o ministério passa a USÁ-LO.
    //
    // Escrever é só do líder, e ninguém apaga: re-importar o mesmo hinário
    // corrige o texto por cima, que é o jeito de consertar um engano.
    match /hinarios/{hinarioId} {
      allow read: if aprovado();

      allow create, update: if ehLider()
        && hinarioId in ['harpa', 'cantor']
        && _indiceValido();

      allow delete: if false;

      // O índice é a lista de títulos que a tela mostra de uma vez. O total
      // tem de bater com a lista: um número que mente aqui apareceria na
      // tela como "640 hinos" sobre um índice de 300.
      function _indiceValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['titulos', 'total', 'atualizadoEm', 'atualizadoPor'])
          && d.titulos is map
          && d.total is int
          && d.total == d.titulos.size()
          && d.total <= 2000
          && d.atualizadoPor == eu()
          && d.atualizadoEm == request.time;
      }

      match /hinos/{numero} {
        allow read: if aprovado();

        allow create, update: if ehLider()
          && hinarioId in ['harpa', 'cantor']
          && _hinoDaBibliotecaValido(numero);

        allow delete: if false;

        // O id do documento é o NÚMERO, e o campo tem de concordar com ele:
        // é o que impede duas cópias do mesmo hino e faz "abrir o hino 15"
        // ser uma leitura por id, sem consulta nenhuma. O teto de 9999 é
        // largo de propósito, pelo mesmo motivo do de `songs`: o teto de
        // verdade (640, 581) mora no app, onde se troca sem deploy de regra.
        function _hinoDaBibliotecaValido(numero) {
          let d = request.resource.data;
          return d.keys().hasOnly(['numero', 'titulo', 'letra', 'importadoPor', 'importadoEm'])
            && d.numero is int
            && d.numero >= 1 && d.numero <= 9999
            && string(d.numero) == numero
            && d.titulo is string
            && d.titulo.size() >= 1 && d.titulo.size() <= 150
            && d.letra is string
            && d.letra.size() >= 1 && d.letra.size() <= 20000
            && d.importadoPor == eu()
            && d.importadoEm == request.time;
        }
      }
    }

    // ── Equipes ─────────────────────────────────────────────────────────────
    // "Equipe Manhã", "Equipe Noite": quem toca, e em quê. Todo mundo lê
    // (os nomes aparecem na escala); só o líder monta.
    match /teams/{teamId} {
      allow read: if aprovado();

      allow create, update: if ehLider()
        && tamanhoRazoavel()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50;

      allow delete: if ehLider();
    }

    // ── Agenda fixa ─────────────────────────────────────────────────────────
    // Um documento só: config/agendaFixa, com as linhas da semana.
    match /config/{documento} {
      allow read: if aprovado();

      allow write: if ehLider()
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 30;
    }

    // ── Cultos / escalas ────────────────────────────────────────────────────
    match /scales/{scaleId} {
      allow read: if aprovado();

      // Vale tanto para o culto avulso do "+" quanto para os que a agenda
      // fixa gera com id determinístico (2026-11-15_0800).
      allow create: if ehLider()
        && tamanhoRazoavel()
        && texto('serviceType', 60)
        && texto('observations', 5000)
        && texto('fromSlot', 40)
        && texto('teamId', 40);

      // O líder edita o culto à vontade. Um levita só pode tocar na lista de
      // presença — nenhum outro campo.
      //
      // Limite conhecido: esta regra garante que o levita mexeu apenas no
      // campo `levitas`, mas não consegue garantir que mexeu só na própria
      // linha dentro dele. Garantir isso exigiria uma confirmação por pessoa,
      // em subcoleção. Como são todos do mesmo ministério e a mudança fica
      // visível na tela, fica assim por ora.
      //
      // Cancelar um culto, mudar a equipe ou marcar como editado à mão são
      // campos do líder: o levita só alcança `levitas`, nada mais.
      allow update: if tamanhoRazoavel()
        // `levitasEm` é o carimbo de "a escalação mudou agora", e é o que o
        // servidor dos avisos confere antes de mandar "você foi escalado".
        // Com a hora do aparelho, um líder com o relógio adiantado faria o
        // carimbo valer por horas — e o id de um culto antigo reavisaria o
        // ministério a qualquer momento.
        && (!('levitasEm' in mudou())
            || request.resource.data.levitasEm == request.time)
        // `confirmadoEm` é o carimbo de "alguém acabou de confirmar", e é o
        // que o servidor dos avisos confere antes de avisar o líder. Mesma
        // razão do `levitasEm`: com a hora do aparelho, um celular adiantado
        // faria o carimbo valer por horas, e o id de um culto antigo — que
        // todo aprovado lê — reavisaria o líder a qualquer momento.
        && (!('confirmadoEm' in mudou())
            || request.resource.data.confirmadoEm == request.time)
        && (
          (ehLider() && texto('serviceType', 60) && texto('observations', 5000))
          // O levita confirma presença: alcança `levitas` e o carimbo, nada
          // mais. O carimbo entra junto porque é a mesma escrita — pedir uma
          // segunda escrita para carimbar dobraria a cota e deixaria o
          // carimbo sem a confirmação quando a segunda falhasse.
          || (aprovado() && mudou().hasOnly(['levitas', 'confirmadoEm']))
        );

      // NINGUÉM apaga culto pelo app, nem o líder.
      //
      // Vale a mesma regra das músicas: cancelar é um campo (`canceled`),
      // nunca exclusão. O culto apagado levava junto quem já tinha confirmado
      // presença, o repertório montado e o registro de quem tocou ali — e no
      // culto da agenda fixa nem resolvia, porque o id vem da data e hora e o
      // gerador o recriava na abertura seguinte.
      //
      // Apagar de verdade, se um dia for mesmo preciso, só pelo console do
      // Firebase — onde não se chega por engano no meio de um culto.
      allow delete: if false;
    }

    // ── Modo Culto ao vivo ──────────────────────────────────────────────────
    // Onde o culto está AGORA: que música, que parte, que linha. Um documento
    // por culto, reescrito por cima, sem histórico — é posição, não registro.
    //
    // POR QUE A LEITURA É DE TODO APROVADO, e não só de quem está escalado:
    // a regra teria de procurar o uid dentro de `levitas`, que é uma lista de
    // mapas, e regra do Firestore não busca dentro de lista de mapas sem
    // consulta. E não protegeria nada: o culto inteiro — inclusive quem está
    // escalado e as músicas — já é legível por todo aprovado. A posição da
    // linha é o dado menos sensível do app.
    match /scales/{scaleId}/aoVivo/{doc} {
      allow read: if aprovado();

      allow create: if aprovado()
        && estadoAoVivoValido()
        && request.resource.data.condutorId == eu();

      allow update: if estadoAoVivoValido()
        && (
          // Quem está conduzindo continua conduzindo.
          (resource.data.condutorId == eu()
              && request.resource.data.condutorId == eu())
          // Soltar o comando: fica livre para quem tocar em "assumir".
          || (resource.data.condutorId == eu()
              && request.resource.data.condutorId == '')
          // Ninguém conduzindo: quem está no culto assume.
          || (aprovado() && resource.data.condutorId == ''
              && request.resource.data.condutorId == eu())
          // O CONDUTOR QUE SUMIU. Celular travado, bateria no fim, app
          // fechado no meio do culto: sem isto o culto ficaria preso
          // esperando alguém que já não está ali, e ninguém assumiria.
          // A conta é a mesma do app (EstadoAoVivo.silencioMaximo).
          || (aprovado()
              && request.resource.data.condutorId == eu()
              && resource.data.atualizadoEm
                  < request.time - duration.value(45, 's'))
          // O líder do ministério tira o comando de quem estiver com ele.
          || ehLider()
        );

      // Estado efêmero: quando o culto acaba, o líder limpa.
      allow delete: if ehLider();
    }

    function estadoAoVivoValido() {
      return tamanhoRazoavel()
        && request.resource.data.condutorId is string
        && request.resource.data.condutorId.size() <= 128
        && texto('condutorNome', 60)
        && request.resource.data.musica is int
        && request.resource.data.musica >= 0
        && request.resource.data.musica <= 200
        && request.resource.data.ancora is int
        && request.resource.data.ancora >= 0
        && request.resource.data.ancora <= 5000
        && texto('secao', 60)
        && texto('texto', 300)
        // A HORA É DO SERVIDOR, sempre. Com a hora do aparelho, um celular
        // adiantado deixaria o estado "vivo" para sempre e ninguém mais
        // assumiria o comando — a trava de 45 s acima depende disto.
        && request.resource.data.atualizadoEm == request.time;
    }

    // ── Chat ────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if aprovado();

      // Você só envia mensagem em seu próprio nome.
      allow create: if aprovado()
        && tamanhoRazoavel()
        && request.resource.data.userId == eu()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        // Mensagem de voz não tem texto. Uma das duas coisas tem de existir,
        // senão dá para encher o chat de bolhas vazias.
        && (request.resource.data.text.size() > 0
            || request.resource.data.audioId is string)
        && texto('audioId', 64)
        && texto('audioTipo', 80)
        && texto('userName', 60)
        // Responder citando: o pedaço do texto citado é COPIADO, porque a
        // mensagem original some em 30 dias.
        && texto('respondeA', 64)
        && texto('respondeANome', 60)
        && texto('respondeATexto', 300)
        // Menções: lista de uid, não de nomes. Mapa de reações não entra na
        // criação — ninguém nasce reagido.
        && (!('mencoes' in request.resource.data)
            || (request.resource.data.mencoes is list
                && request.resource.data.mencoes.size() <= 30))
        && !('reacoes' in request.resource.data);

      // Mensagem enviada não se reescreve: o texto é o que foi dito, e
      // ninguém reescreve o que disse ontem.
      //
      // Duas exceções, e só duas: o líder alcança os três campos de fixar, e
      // cada pessoa alcança a PRÓPRIA reação.
      allow update: if
        (
          ehLider()
          && mudou().hasOnly(['fixada', 'fixadaPor', 'expiraEm'])
          && request.resource.data.fixada is bool
          && texto('fixadaPor', 128)
          && (request.resource.data.expiraEm == null
              || request.resource.data.expiraEm is timestamp)
          // Fixada não vence; não fixada tem prazo. Sem isto, fixar sem
          // tirar o prazo deixaria a mensagem no topo até a faxina a apagar.
          && (request.resource.data.fixada
              ? request.resource.data.expiraEm == null
              : request.resource.data.expiraEm != null)
        )
        || (
          aprovado()
          && mudou().hasOnly(['reacoes'])
          && soMinhaReacao()
          && reacaoValida()
        );

      // Reagir mexe SÓ na própria chave do mapa.
      //
      // `diff().affectedKeys()` é o que impede tirar a reação de outra
      // pessoa, ou reagir em nome dela — sem isto, qualquer aprovado
      // reescreveria o mapa inteiro.
      //
      // O `get('reacoes', {})` nos dois lados não é zelo: mensagem gravada
      // antes desta mudança NÃO TEM o campo, e ler `resource.data.reacoes`
      // direto faria a regra dar erro — recusando toda reação em toda
      // mensagem antiga do chat.
      function soMinhaReacao() {
        return request.resource.data.get('reacoes', {})
            .diff(resource.data.get('reacoes', {}))
            .affectedKeys().hasOnly([eu()]);
      }

      // Emoji da lista fechada, e um mapa que não cresce sem limite.
      //
      // Minha chave AUSENTE é válido: é assim que se tira a reação.
      function reacaoValida() {
        return request.resource.data.get('reacoes', {}).size() <= 200
          && (!(eu() in request.resource.data.get('reacoes', {}))
              || request.resource.data.reacoes[eu()]
                  in ['👍', '🙏', '❤️', '🔥', '😂']);
      }

      // A conversa some depois de 30 dias, e quem apaga é uma faxina que
      // roda de madrugada entrando como líder. Não é exclusão de conteúdo
      // alheio: é o combinado do chat, e a mensagem fixada fica de fora.
      //
      // Diferente de `songs`, onde apagar está fechado para todos: lá o
      // repertório é património da igreja; aqui é recado de combinação, e o
      // valor está em sumir.
      allow delete: if ehLider();
    }

    // ── Mensagens de voz ────────────────────────────────────────────────────
    // Os bytes ficam aqui, num documento por áudio, e NÃO dentro da mensagem.
    // A razão é custo: o chat escuta `messages` o tempo todo, e áudio junto
    // faria cada abertura baixar meio mega por minuto de voz da conversa
    // inteira. Assim só desce quando alguém toca no play.
    //
    // Não é Cloud Storage porque o Storage saiu do plano gratuito: exigiria
    // Blaze, e este projeto fica no Spark.
    match /audios/{audioId} {
      allow read: if aprovado();

      allow create: if aprovado()
        && tamanhoRazoavel()
        && request.resource.data.userId == eu()
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() > 0
        // 800 KiB. O documento do Firestore vai até 1 MiB, e dois minutos
        // medidos saíram com 531 KiB; a folga cobre um aparelho que grave
        // mais gordo sem a escrita inteira ser recusada pelo banco.
        && request.resource.data.bytes.size() <= 819200
        && request.resource.data.duracaoMs is int
        && request.resource.data.duracaoMs > 0
        // Dois minutos, com folga para o relógio do aparelho.
        && request.resource.data.duracaoMs <= 125000
        && texto('tipo', 80)
        && request.resource.data.expiraEm is timestamp;

      // Fixar a mensagem tira o prazo do áudio junto; desafixar devolve.
      // Nada mais se altera: os bytes gravados são os bytes gravados.
      allow update: if ehLider() && mudou().hasOnly(['expiraEm']);

      // O líder (e a faxina, que entra como líder) apaga; o autor apaga o
      // próprio. Ninguém apaga áudio alheio.
      allow delete: if ehLider()
        || (aprovado() && resource.data.userId == eu());
    }

    // ── Trava do lembrete da véspera ────────────────────────────────────────
    // Um documento por dia, escrito pelo robô que dispara o lembrete. Serve a
    // uma coisa só: o job pode rodar duas vezes (nova tentativa, disparo à
    // mão) e ninguém merece dois lembretes do mesmo culto.
    //
    // Só o líder, porque o robô entra como líder — este projeto não usa chave
    // de administrador.
    // ── "Já avisei os líderes deste pedido de entrada" ─────────────────────
    //
    // Um documento por cadastro, escrito pelo servidor dos avisos (que entra
    // como líder comum). É o que faz cada cadastro avisar UMA vez na vida.
    //
    // Por que não uma janela de tempo, como no chat e na escala: o único
    // carimbo disponível seria o `createdAt` do cadastro, que vem do relógio
    // do APARELHO — um celular adiantado valeria por dias, um atrasado nunca
    // avisaria. A marca não depende de relógio nenhum.
    //
    // Quem está pendente NÃO lê nem escreve isto: saber se o líder já foi
    // avisado não é assunto de quem está esperando, e deixar escrever seria
    // deixar apagar a marca para avisar de novo.
    // ── Saúde do sistema ───────────────────────────────────────────────────
    //
    // "Rodou às tantas horas", um documento por rotina. Existe porque os
    // robôs falharam em silêncio por dias: a rotina diária batia num 403, o
    // motivo ficava no log do Worker, e ninguém abre log de Worker. Com o
    // carimbo, o app sabe dizer "o lembrete da véspera não roda há três
    // dias", e o cartão no Perfil do líder fica vermelho.
    match /saude/{qual} {
      // Todo aprovado LÊ. O cartão é só do líder, mas esconder a leitura não
      // protegeria nada: não há aqui nada além de datas e "deu certo".
      allow read: if aprovado();

      // Escreve quem é líder — e os robôs são líderes comuns. Leitura e
      // escrita em linhas separadas, pelo mesmo motivo das coleções acima:
      // `tamanhoRazoavel()` lê `request.resource`, que não existe na leitura.
      //
      // A HORA É DO SERVIDOR, e aqui isso não é zelo: com a hora do runner do
      // GitHub, um relógio torto faria o carimbo parecer mais novo do que é,
      // e a tela diria "rodou hoje" sobre uma rotina parada há uma semana.
      // Alarme que mente é pior que alarme nenhum.
      allow create, update: if ehLider()
        && qual in ['cultos', 'vespera', 'faxina']
        && tamanhoRazoavel()
        && request.resource.data.keys().hasOnly(['em', 'ok', 'detalhe'])
        && request.resource.data.em == request.time
        && request.resource.data.ok is bool
        && texto('detalhe', 300);

      // Apagar o carimbo faria a rotina parecer "sem registro" em vez de
      // parada — exatamente o silêncio que isto veio quebrar.
      allow delete: if false;
    }

    match /pedidosAvisados/{userId} {
      // Leitura e escrita em linhas separadas, pelo mesmo motivo de
      // `avisosDaVespera`: `tamanhoRazoavel()` lê `request.resource`, que não
      // existe numa leitura, e juntas a regra negaria o `get` do próprio robô.
      allow read: if ehLider();
      allow write: if ehLider() && tamanhoRazoavel();
    }

    match /avisosDaVespera/{dia} {
      // Leitura e escrita em linhas SEPARADAS: `tamanhoRazoavel()` lê
      // `request.resource`, que não existe numa leitura — juntas, a regra
      // dava erro e negava o `get` que o próprio robô faz para saber se já
      // mandou o lembrete de hoje. Foi o teste que pegou.
      allow read: if ehLider();
      allow write: if ehLider() && tamanhoRazoavel();
    }

    // ── Até onde cada um leu o chat ─────────────────────────────────────────
    // UM documento por pessoa, não um carimbo por mensagem: marcar cada
    // mensagem como lida por cada pessoa seriam 15 escritas por mensagem num
    // ministério de 15, e a cota gratuita do Spark acabaria numa tarde.
    //
    // A leitura é de todo aprovado, porque é disso que saem os dois tiques
    // azuis na bolha de quem enviou.
    match /chatLeituras/{userId} {
      allow read: if aprovado();

      allow write: if souEu(userId)
        && aprovado()
        && tamanhoRazoavel()
        && request.resource.data.userId == userId
        && texto('userName', 60)
        // A hora é do SERVIDOR. Com a hora do aparelho, bastaria adiantar o
        // relógio para ganhar dois tiques azuis em mensagem que ninguém leu.
        && request.resource.data.lidoAte == request.time;

      // Ninguém apaga o marcador de outra pessoa; o próprio pode, ao sair.
      allow delete: if souEu(userId) || ehLider();
    }

    // ── Avisos do chat ──────────────────────────────────────────────────────
    // Uma inscrição por APARELHO, não por pessoa: quem usa o app no celular e
    // no computador recebe nos dois, e o id do documento é um número sorteado
    // guardado naquele navegador.
    //
    // POR QUE A LEITURA É FECHADA
    //
    // O `endpoint` é uma CHAVE, não um endereço: quem o tem manda notificação
    // para aquele celular direto, sem passar pelo Worker e sem limite nenhum.
    // Então ninguém lê a inscrição de outra pessoa — nem um levita aprovado.
    // Quem lê a lista inteira é o robô dos avisos, que entra como líder, pelo
    // mesmo motivo e com a mesma senha da faxina do chat: chave de
    // administrador ignoraria todas estas regras.
    match /pushSubs/{aparelhoId} {
      allow read: if ehLider()
        || (aprovado() && resource.data.userId == eu());

      allow create, update: if aprovado()
        && tamanhoRazoavel()
        && request.resource.data.userId == eu()
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 0
        && request.resource.data.endpoint.size() <= 500
        // Só https: o endpoint vem do próprio navegador, e um valor http
        // aqui significa que alguém o escreveu à mão.
        && request.resource.data.endpoint.matches('https://.*')
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.size() > 0
        && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string
        && request.resource.data.auth.size() > 0
        && request.resource.data.auth.size() <= 60
        && request.resource.data.avisosLigados is bool
        // Nulo é o normal: só quem tocou em "Silenciar até amanhã" tem data.
        && (request.resource.data.silenciarAte == null
            || request.resource.data.silenciarAte is timestamp)
        // Cada tipo de aviso se liga à parte. Lista fechada, e só booleano:
        // uma chave inventada aqui seria um aviso que o app nunca mostra e
        // ninguém consegue desligar.
        && (!('tipos' in request.resource.data)
            || (request.resource.data.tipos is map
                && request.resource.data.tipos.keys()
                    .hasOnly(['chat', 'escalado', 'vespera'])
                && request.resource.data.tipos.values()
                    .hasOnly([true, false])))
        && texto('userName', 60);

      // O dono apaga (sair do app, trocar de aparelho) e o líder também — é
      // como o robô limpa as inscrições que o serviço de push já recusa.
      allow delete: if ehLider()
        || (aprovado() && resource.data.userId == eu());
    }

    // ── "Está digitando…" ───────────────────────────────────────────────────
    match /typing/{userId} {
      allow read: if aprovado();
      allow write: if souEu(userId) && aprovado() && texto('userName', 60);
    }

    // Qualquer outra coleção fica bloqueada por não ter regra definida.
  }
}
